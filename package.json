{
  "name": "arca-api-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador local de ARCA (WSAA + WSFEv1): mismo contrato SOAP que homologacion, sin validez fiscal",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "cert": "sh scripts/generar-certificado.sh"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "soap": "^1.1.12",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
